<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ExamenPractico.FeedbackPage"
             Title="Feedback">

    <VerticalStackLayout Padding="24" Spacing="16">
        <Label Text="Déjanos tus comentarios sobre la app:" FontSize="16" />

        <Entry x:Name="FeedbackEntry"
               Placeholder="Escribe tu mensaje aquí..."
               HeightRequest="50" />

        <Label Text="Fecha del suceso o sugerencia:" FontSize="14" TextColor="#8E8E93" Margin="0, 10, 0, -8" />
        <DatePicker x:Name="FeedbackDate"
                    Format="dd/MM/yyyy"
                    HeightRequest="50" />

        <Label Text="¿Recomendarías la aplicación?" FontSize="14" TextColor="#8E8E93" Margin="0, 10, 0, 0" />
        <HorizontalStackLayout Spacing="20">
            <HorizontalStackLayout>
                <CheckBox x:Name="CheckSi" CheckedChanged="OnCheckSiChanged" />
                <Label Text="Sí" VerticalOptions="Center" />
            </HorizontalStackLayout>

            <HorizontalStackLayout>
                <CheckBox x:Name="CheckNo" CheckedChanged="OnCheckNoChanged" />
                <Label Text="No" VerticalOptions="Center" />
            </HorizontalStackLayout>
        </HorizontalStackLayout>

        <Button Text="Enviar Feedback"
                Clicked="OnSendFeedback"
                CornerRadius="10"
                Margin="0, 10, 0, 0" />

        <Label x:Name="ThanksLabel"
               Text="¡Gracias!"
               FontSize="22"
               FontAttributes="Bold"
               HorizontalOptions="Center"
               IsVisible="False"
               Margin="0, 20, 0, 0" FontFamily="Velvet Muse" />
    </VerticalStackLayout>
</ContentPage>